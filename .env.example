# ---------------------------------------------------------------------------
# Seahub Comercial — variáveis de ambiente.
#
# Copie para `.env` e preencha para desenvolvimento local.
# NUNCA commite o `.env` real (o .gitignore cobre).
# Em PRODUÇÃO, estes valores entram como ENV do serviço no Easypanel.
#
# Este arquivo lista NOMES, nunca valores.
# ---------------------------------------------------------------------------

# --- Aplicação -------------------------------------------------------------
NODE_ENV=development
APP_URL=http://localhost:3000
# Todo corte de dia acontece no relógio de parede da empresa.
APP_TIMEZONE=America/Fortaleza

# --- Banco -----------------------------------------------------------------
# Local (docker compose up -d db) — porta 5433 p/ não colidir com o financeiro.
DATABASE_URL=postgres://comercial:comercial@localhost:5433/seahub_comercial

# --- Sessão ----------------------------------------------------------------
# Gere um segredo forte:  openssl rand -base64 48
SESSION_SECRET=

# --- Primeiro admin (só no primeiro boot; pode remover depois) --------------
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_NAME=

# --- Conexa (SOMENTE LEITURA) ----------------------------------------------
CONEXA_BASE_URL=https://seahubcoworking.conexa.app/index.php/api/v2
# Token permanente de admin. SECRET.
CONEXA_API_TOKEN=

# TETO de requisições por minuto, não alvo. Medido: limite da API = 60, e zero
# consumo de terceiros (o financeiro em produção usa login web, não a API v2).
# A folga de ~25 req/min é para a rajada futura dos agentes do Chatwoot.
CONEXA_RATE_LIMIT_PER_MIN=35

# Segredo do header `x-cron-secret` das rotas de sync/regras.
CRON_SECRET=

# --- Agendadores (ADR-0003) ------------------------------------------------
SYNC_SCHEDULER=on
INTEL_SCHEDULER=on

# --- Disparo — TODOS OS DEFAULTS FECHAM (ADR-0004) -------------------------
# Kill-switch global de emergência. Funciona mesmo com a UI quebrada.
NOTIFICADOR=off
NOTIFICADOR_MODO=dry-run
# Disjuntor contra bug multiplicativo: a execução vira HALTED, não continua.
NOTIFICADOR_MAX_POR_EXECUCAO=50

# ClickUp — único canal da fase 1
CLICKUP_ENABLED=off
# ⚠ Token de usuário-ROBÔ, nunca de pessoa: quando o funcionário sai, o token
# morre e as tasks ficam órfãs. Vai CRU no header Authorization, sem "Bearer".
CLICKUP_TOKEN=
# Lista ALVO — destino é allowlist fechada (ADR-0009).
CLICKUP_LIST_ID=
# Task de vendedor não mapeado cai aqui, sem responsável. Nunca no chute.
CLICKUP_LIST_TRIAGEM_ID=

# Chatwoot — fase 2, abordagem ainda a desenhar
CHATWOOT_ENABLED=off
CHATWOOT_BASE_URL=https://chatwoot.seahealth.io/api/v1
# Header próprio `api_access_token`, também sem "Bearer".
CHATWOOT_TOKEN=
CHATWOOT_ACCOUNT_ID=
