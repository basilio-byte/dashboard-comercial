// Modelo de dados do Dashboard Comercial Seahub.
//
// Convenções herdadas do projeto irmão:
//  - toda entidade do Conexa guarda `conexaId` (chave natural, idempotência),
//    `raw` (JSON bruto para auditoria) e `syncedAt`;
//  - dinheiro é sempre Decimal(14,2) — nunca float;
//  - prefixos de tabela: dim_ (cadastros), fact_ (fatos), intel_ (derivados).
//
// As entidades de reserva/saldo entram nas Fases 2 e 3. Ver docs/context/roadmap.md.

generator client {
  provider      = "prisma-client-js"
  // native = dev local; linux-musl-openssl-3.0.x = runtime Alpine (Docker/Easypanel)
  binaryTargets = ["native", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ===========================================================================
// Autenticação / usuários internos
// ===========================================================================

enum UserRole {
  ADMIN // configura integração, regras, disparo e usuários
  COMERCIAL // trabalha a fila de sinais
  VIEWER // apenas visualiza
}

model User {
  id           String    @id @default(cuid())
  email        String    @unique
  name         String
  passwordHash String
  role         UserRole  @default(VIEWER)
  isActive     Boolean   @default(true)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  lastLoginAt  DateTime?

  sessions    Session[]
  loginEvents LoginEvent[]

  @@map("users")
}

/// Sessões server-side (revogáveis). O cookie guarda só o id da sessão.
model Session {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime @default(now())
  userAgent String?
  ip        String?

  @@index([userId])
  @@index([expiresAt])
  @@map("sessions")
}

model LoginEvent {
  id        String   @id @default(cuid())
  userId    String?
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  email     String
  success   Boolean
  reason    String?
  ip        String?
  userAgent String?
  createdAt DateTime @default(now())

  @@index([email])
  @@index([createdAt])
  @@map("login_events")
}

// ===========================================================================
// Dimensões — cadastros do Conexa, mudam pouco
// ===========================================================================

model Company {
  conexaId  Int      @id
  name      String?
  raw       Json
  syncedAt  DateTime @default(now())

  @@map("dim_companies")
}

model ServiceCategory {
  conexaId Int      @id
  name     String?
  raw      Json
  syncedAt DateTime @default(now())

  @@map("dim_service_categories")
}

model Plan {
  conexaId                Int      @id
  companyConexaId         Int?
  name                    String?
  serviceCategoryConexaId Int?
  isActive                Boolean  @default(true)

  /// Horas mensais INCLUSAS no plano, como o Conexa declara em `hourQuotas`.
  ///
  /// Descoberta da Fase 0 e peça central da regra 10: o tier do Endereço Fiscal
  /// (Litoral / Batial / Abissal / Comércio) NÃO é campo da API, mas a cota é —
  /// e ela distingue os tiers sem depender do nome. Litoral não tem cota;
  /// Batial tem 2h; Abissal 8h; Comércio e Black 6h; Simples 4h.
  ///
  /// `null` significa **plano sem horas inclusas** (é o caso do Litoral), e é
  /// diferente de zero. Ver docs/context/fase-0-conclusoes.md.
  horasInclusasMes        Decimal? @db.Decimal(10, 2)
  /// Cru das cotas, para auditoria e para a Fase 3 (ciclo, grupo, sala).
  hourQuotasRaw           Json?

  raw      Json
  syncedAt DateTime @default(now())

  @@index([serviceCategoryConexaId])
  @@index([companyConexaId])
  @@map("dim_plans")
}

model Product {
  conexaId                Int      @id
  companyConexaId         Int?
  name                    String?
  serviceCategoryConexaId Int?
  price                   Decimal? @db.Decimal(14, 2)
  isActive                Boolean  @default(true)
  raw                     Json
  syncedAt                DateTime @default(now())

  @@index([serviceCategoryConexaId])
  @@index([companyConexaId])
  @@map("dim_products")
}

model Customer {
  conexaId        Int      @id
  companyConexaId Int?
  name            String?
  tradeName       String?
  document        String? // CPF/CNPJ
  isJuridicalPerson Boolean @default(false)
  /// Gate de elegibilidade (ADR-0010): cliente inativo ou bloqueado nunca recebe
  /// oferta. São colunas, e não leitura do `raw`, para poderem ir no WHERE.
  isActive        Boolean  @default(true)
  isBlocked       Boolean  @default(false)
  city            String?
  state           String?
  createdAtConexa DateTime?
  raw             Json
  syncedAt        DateTime @default(now())

  contracts Contract[]
  monthly   CustomerMonthlyRevenue[]
  profile   CustomerProfile?

  @@index([companyConexaId])
  @@index([isActive, isBlocked])
  @@map("dim_customers")
}

// ===========================================================================
// Fatos
// ===========================================================================

model Contract {
  conexaId           Int       @id
  customerConexaId   Int?
  customer           Customer? @relation(fields: [customerConexaId], references: [conexaId], onDelete: SetNull)
  planConexaId       Int?
  companyConexaId    Int?
  costCenterConexaId Int?
  sellerId           Int?
  amount             Decimal   @db.Decimal(14, 2)
  paymentFrequency   String? // Monthly | Bimonthly | Quarterly | Semester | Yearly
  startDate          DateTime? @db.Date
  endDate            DateTime? @db.Date
  isActive           Boolean   @default(true)
  dueDay             Int?
  fidelityDate       DateTime? @db.Date
  contractSummary    String?

  /// Cota de horas do CONTRATO (sobrepõe a do plano quando existe).
  /// Fase 0: 100% das cotas reais são por grupo (id 2, único). Guardado cru
  /// porque o ciclo e o carry-over ainda são incógnitas — Fase 3.
  hourPlanQuotaRaw   Json?

  createdAtConexa DateTime?
  updatedAtConexa DateTime?
  raw             Json
  syncedAt        DateTime  @default(now())

  @@index([customerConexaId])
  @@index([isActive])
  @@index([startDate])
  @@index([endDate])
  @@index([planConexaId])
  @@map("fact_contracts")
}

model Sale {
  conexaId         Int       @id
  customerConexaId Int?
  productConexaId  Int?
  contractConexaId Int?
  recurringSaleId  Int?
  sellerId         Int?
  amount           Decimal   @db.Decimal(14, 2)
  originalAmount   Decimal?  @db.Decimal(14, 2)
  discountValue    Decimal?  @db.Decimal(14, 2)

  /// Quantidade vendida. Numa venda gerada por reserva de sala, é a DURAÇÃO EM
  /// HORAS — confirmado na Fase 0 (20/20 pares reserva×venda concordam).
  /// ⚠ A coleção Postman tipa o campo como `integer` e como "quantidade de
  /// itens"; a documentação está errada e o dado real carrega fracionário.
  quantity         Decimal?  @db.Decimal(14, 4)

  status           String?
  referenceDate    DateTime?
  createdAtConexa  DateTime?
  updatedAtConexa  DateTime?
  raw              Json
  syncedAt         DateTime  @default(now())

  @@index([customerConexaId])
  @@index([productConexaId])
  @@index([contractConexaId])
  @@index([referenceDate])
  @@map("fact_sales")
}

/// Cobrança — a fonte da RECEITA.
///
/// A régua é copiada literalmente do dashboard financeiro (ADR-0006), porque a
/// receita do comercial precisa bater ao centavo com a dele. Em particular:
///  - o regime é o de EMISSÃO (`emissionDate`), que é o que a Seahub usa no dia
///    a dia;
///  - o valor é `currentAmount` (COM juros/multa), NÃO `amount`;
///  - cancelada e `negotiated` saem dos totais — a segunda porque o Conexa cria
///    uma cobrança NOVA na renegociação, e somar as duas é dupla contagem.
model Charge {
  conexaId         Int       @id
  companyConexaId  Int?
  customerConexaId Int?
  status           String? // unpaid | paid | cancelled | negotiated | ...
  type             String?
  receivingMethod  String?

  amount        Decimal  @db.Decimal(14, 2)
  currentAmount Decimal? @db.Decimal(14, 2) // com juros/multa — é o que a tela do Conexa soma
  paidAmount    Decimal? @db.Decimal(14, 2)

  competenceDate DateTime? @db.Date
  dueDate        DateTime? @db.Date
  paymentDate    DateTime? @db.Date
  cancelDate     DateTime? @db.Date

  /// Data de EMISSÃO = `createdAt` do Conexa convertido para America/Fortaleza.
  /// Materializada como Date para ser filtrada por índice: `createdAtConexa` é
  /// timestamp, e converter o fuso a cada consulta descartaria o índice.
  emissionDate DateTime? @db.Date

  salesIds        Int[]
  createdAtConexa DateTime?
  updatedAtConexa DateTime?
  raw             Json
  syncedAt        DateTime  @default(now())

  @@index([customerConexaId])
  @@index([companyConexaId])
  @@index([status])
  @@index([emissionDate])
  @@index([paymentDate])
  @@map("fact_charges")
}

/// Reserva de sala. É o consumo de horas — a outra metade do saldo.
///
/// ⚠ Os campos de horário são `startTime`/`finalTime`, **não** `startAt`. O
/// documento de especificação registra isso como armadilha já vivida.
///
/// `status` carrega a informação central: **`deductedFromQuota`** marca a
/// reserva que o próprio Conexa abateu da cota do cliente. Isso dispensa saber
/// quais salas compõem o grupo da cota — a pergunta "esta reserva consome a
/// cota?" já vem respondida no dado. Ver ADR-0005 e fase-0-conclusoes.md.
model RoomBooking {
  conexaId         Int       @id
  customerConexaId Int?
  personConexaId   Int?
  saleConexaId     Int?
  placeConexaId    Int?
  placeName        String?

  status           String? // deductedFromQuota | billed | notBilled | ...
  isActive         Boolean   @default(true)
  isBilled         Boolean   @default(false)
  completed        Boolean   @default(false)
  cancellationReason String?
  recurringBookingId Int?

  startTime DateTime?
  finalTime DateTime?
  /// Duração em horas, materializada: (finalTime - startTime). Evita recalcular
  /// a diferença a cada agregação e permite somar no banco.
  horas     Decimal?  @db.Decimal(10, 4)
  /// Data-calendário do início, no fuso da empresa — para cortar por ciclo
  /// usando índice.
  dataLocal DateTime? @db.Date

  createdAtConexa DateTime?
  updatedAtConexa DateTime?
  raw             Json
  syncedAt        DateTime  @default(now())

  @@index([customerConexaId, dataLocal])
  @@index([status])
  @@index([dataLocal])
  @@map("fact_room_bookings")
}

// ===========================================================================
// Inteligência comercial — derivados
// ===========================================================================

/// Procedência de um número exibido. Nenhuma tela mostra valor sem isto, e
/// nenhuma regra de negócio dispara sobre procedência INDISPONIVEL.
/// Ver docs/context/decisions.md (ADR-0005) e a regra de ouro do projeto.
enum Procedencia {
  API // veio direto de um campo da API
  DERIVADO // calculado a partir de campos da API, com fórmula registrada
  MANUAL // cadastrado à mão por um humano
  INDISPONIVEL // a API não expõe e não há como derivar — é lacuna, não zero
}

/// Receita de um cliente num mês, no regime de EMISSÃO.
///
/// Materializada (e não calculada a cada request) porque a tela de um cliente
/// precisa de 12 meses e a lista precisa do ano inteiro de ~5.500 clientes.
model CustomerMonthlyRevenue {
  id               String   @id @default(cuid())
  customerConexaId Int
  customer         Customer @relation(fields: [customerConexaId], references: [conexaId], onDelete: Cascade)
  /// 'yyyy-MM'
  mesKey           String
  receita          Decimal  @db.Decimal(14, 2)
  cobrancas        Int      @default(0)
  /// Variação percentual contra o mês anterior. **NULL quando o anterior é
  /// zero** — sem base não existe "queda de X%". Critério de aceite da Fase 1.
  variacaoPct      Decimal? @db.Decimal(10, 4)
  procedencia      Procedencia @default(DERIVADO)
  calculadoEm      DateTime @default(now())

  @@unique([customerConexaId, mesKey])
  @@index([mesKey])
  @@map("intel_customer_monthly_revenue")
}

/// Perfil consolidado por cliente — o que a tela de lista e a de detalhe usam.
model CustomerProfile {
  customerConexaId Int      @id
  customer         Customer @relation(fields: [customerConexaId], references: [conexaId], onDelete: Cascade)

  receitaAnoCorrente Decimal @db.Decimal(14, 2) @default(0)
  receita12Meses     Decimal @db.Decimal(14, 2) @default(0)
  /// Mês fechado mais recente com receita, e o valor.
  ultimoMesComReceita String?
  /// Segmentos do cliente, derivados de contrato → plano → categoria de serviço.
  /// Nunca por substring do nome do produto.
  segmentos          String[]
  /// Horas mensais inclusas somadas dos contratos ativos. `null` = sem cota
  /// (é o caso do Endereço Fiscal Litoral), que NÃO é o mesmo que zero.
  horasInclusasMes   Decimal? @db.Decimal(10, 2)
  temContratoAtivo   Boolean  @default(false)
  contratosAtivos    Int      @default(0)
  /// Início do contrato ativo mais antigo — âncora dos marcos (regras 1, 6, 7, 8).
  contratoDesde      DateTime? @db.Date

  procedencia Procedencia @default(DERIVADO)
  calculadoEm DateTime    @default(now())

  @@index([receitaAnoCorrente])
  @@map("intel_customer_profile")
}

// ===========================================================================
// Sincronização
// ===========================================================================

enum SyncStatus {
  RUNNING
  SUCCESS
  FAILED
  HALTED // parou no teto/disjuntor — não é falha, é freio
}

model SyncRun {
  id           String     @id @default(cuid())
  mode         String // dimensions | backfill | reconcile | intelligence
  entity       String?
  status       SyncStatus @default(RUNNING)
  startedAt    DateTime   @default(now())
  finishedAt   DateTime?
  requestsMade Int        @default(0)
  recordsRead  Int        @default(0)
  recordsWrote Int        @default(0)
  error        String?
  detail       Json?

  /// Identidade do PROCESSO dono deste run, com heartbeat.
  ///
  /// O irmão enterra zumbis marcando TODO run RUNNING como falho no boot — o que
  /// só vale sob a premissa "um container só" e quebra com duas réplicas (o boot
  /// da segunda mata o backfill vivo da primeira). Com estes dois campos o
  /// enterro passa a ser por heartbeat velho. Ver ADR-0003.
  ownerId     String?
  heartbeatAt DateTime?

  @@index([entity, status, finishedAt])
  @@index([startedAt])
  @@map("sync_runs")
}

/// Progresso da sincronização por ENTIDADE e JANELA mensal.
///
/// Substitui o cursor de offset global, que tinha um buraco: uma deleção no
/// Conexa deslocava a paginação e o registro na posição do cursor nunca era
/// lido — e no fim o sistema declarava a entidade completa. Com janelas, o
/// deslocamento fica contido num mês e reprocessar é barato e idempotente.
///
/// Completude passa a ser "todas as janelas do período estão CONCLUIDA", que é
/// verificável, em vez de "o cursor chegou ao fim", que não é.
model SyncWindow {
  entidade  String
  /// 'yyyy-MM'
  janela    String
  status    JanelaStatus @default(PENDENTE)
  /// Offset já consumido DENTRO da janela — permite retomar no meio dela.
  offset    Int          @default(0)
  registros Int          @default(0)
  erro      String?
  iniciadaEm DateTime?
  concluidaEm DateTime?
  atualizadaEm DateTime @updatedAt

  @@id([entidade, janela])
  @@index([entidade, status])
  @@map("sync_windows")
}

enum JanelaStatus {
  PENDENTE
  EM_ANDAMENTO
  CONCLUIDA
  FALHOU
}

/// Cursor de retomada por entidade/janela.
///
/// Sem isto o backfill sempre parte do offset 0 — e como o container morre em
/// todo redeploy do Easypanel, uma carga de horas é jogada fora pela metade.
/// O irmão registrou o custo: "o retrabalho comeu o ganho". Ver ADR-0008.
model SyncState {
  key       String   @id // ex.: "charges:offset" | "contracts:offset"
  cursor    String?
  updatedAt DateTime @updatedAt
  detail    Json?

  @@map("sync_state")
}
