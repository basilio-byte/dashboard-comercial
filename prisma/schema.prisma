// Modelo de dados do Dashboard Comercial Seahub.
//
// ESTE É O ESQUELETO. As entidades de domínio (espelho do Conexa, perfil do
// cliente, motor de regras, disparo) entram nas Fases 1–6 — o modelo delas
// depende do resultado da Fase 0, que decide o que a API realmente entrega.
// Ver docs/context/roadmap.md e docs/context/decisions.md.
//
// Convenções herdadas do projeto irmão:
//  - toda entidade do Conexa guarda `conexaId` (chave natural, idempotência),
//    `raw` (JSON bruto para auditoria) e `syncedAt`;
//  - dinheiro é sempre Decimal(14,2) — nunca float;
//  - prefixos de tabela: dim_ (cadastros), fact_ (fatos), intel_ (derivados).

generator client {
  provider = "prisma-client-js"
  // native = dev local; linux-musl-openssl-3.0.x = runtime Alpine (Docker/Easypanel)
  binaryTargets = ["native", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ===========================================================================
// Autenticação / usuários internos
// ===========================================================================

enum UserRole {
  ADMIN // configura integração, regras, disparo e usuários
  COMERCIAL // trabalha a fila de sinais; propõe mudança de regra
  VIEWER // apenas visualiza
}

model User {
  id           String    @id @default(cuid())
  email        String    @unique
  name         String
  passwordHash String
  role         UserRole  @default(VIEWER)
  isActive     Boolean   @default(true)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  lastLoginAt  DateTime?

  sessions    Session[]
  loginEvents LoginEvent[]

  @@map("users")
}

/// Sessões server-side (revogáveis). O cookie guarda só o id da sessão.
model Session {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime @default(now())
  userAgent String?
  ip        String?

  @@index([userId])
  @@index([expiresAt])
  @@map("sessions")
}

/// Auditoria de acesso.
model LoginEvent {
  id        String   @id @default(cuid())
  userId    String?
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  email     String
  success   Boolean
  reason    String?
  ip        String?
  userAgent String?
  createdAt DateTime @default(now())

  @@index([email])
  @@index([createdAt])
  @@map("login_events")
}

// ===========================================================================
// Sincronização
// ===========================================================================

enum SyncStatus {
  RUNNING
  SUCCESS
  FAILED
  HALTED // parou no teto/disjuntor — não é falha, é freio
}

/// Uma execução de sincronização. Base do "selo de completude" do ADR-0011:
/// nenhuma regra roda sobre entidade cujo último SyncRun não tenha sucesso
/// dentro do SLA.
model SyncRun {
  id            String     @id @default(cuid())
  mode          String // dimensions | backfill | reconcile | repair | intelligence
  entity        String? // qual entidade este run cobre (null = várias)
  status        SyncStatus @default(RUNNING)
  startedAt     DateTime   @default(now())
  finishedAt    DateTime?
  requestsMade  Int        @default(0)
  recordsRead   Int        @default(0)
  recordsWrote  Int        @default(0)
  error         String?
  detail        Json?

  /// Identidade do PROCESSO dono deste run, com heartbeat.
  ///
  /// O projeto irmão enterra zumbis marcando TODO run RUNNING como falho no
  /// boot — o que só é correto sob a premissa "um container só", e quebra feio
  /// com duas réplicas (o boot da segunda mata o backfill vivo da primeira e
  /// ainda libera a guarda de concorrência). Ver ADR-0003.
  ///
  /// Com estes dois campos, o enterro passa a ser por heartbeat velho, e não
  /// por "existe um RUNNING". O regime declarado hoje é réplica única, mas o
  /// modelo já não depende disso para estar correto.
  ownerId     String?
  heartbeatAt DateTime?

  @@index([entity, status, finishedAt])
  @@index([startedAt])
  @@map("sync_runs")
}

/// Cursor de retomada por entidade/janela.
///
/// Sem isto o backfill sempre parte do offset 0 — e como o container do
/// Easypanel morre em todo redeploy, um backfill de horas é jogado fora pela
/// metade. O projeto irmão registrou o custo: "como o backfill reinicia do
/// zero, o retrabalho comeu o ganho". Ver ADR-0008.
model SyncState {
  key       String   @id // ex.: "bookings:2025-03" | "contracts:offset"
  cursor    String? // offset, data da última janela fechada, id, ...
  updatedAt DateTime @updatedAt
  detail    Json?

  @@map("sync_state")
}
